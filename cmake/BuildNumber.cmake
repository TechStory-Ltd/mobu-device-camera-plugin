# Run with cmake -P at every build (see the oscCamera_version target in CMakeLists.txt):
# adds one to the build number kept in BUILD_NUMBER_FILE and writes the version header OUTPUT_HEADER.
#   -DBUILD_NUMBER_FILE=<file>  -DOUTPUT_HEADER=<file>  -DVERSION_MAJOR=<n>  -DVERSION_MINOR=<n>  [-DOUTPUT_INNO=<file>]
# OUTPUT_INNO is the same version as an Inno Setup include for setup_package/Setup.iss.

set(BUILD_NUMBER 0)
if(EXISTS "${BUILD_NUMBER_FILE}")
	file(READ "${BUILD_NUMBER_FILE}" BUILD_NUMBER_TEXT)
	string(STRIP "${BUILD_NUMBER_TEXT}" BUILD_NUMBER_TEXT)
	if(BUILD_NUMBER_TEXT MATCHES "^[0-9]+$")
		set(BUILD_NUMBER ${BUILD_NUMBER_TEXT})
	endif()
endif()

math(EXPR BUILD_NUMBER "${BUILD_NUMBER} + 1")
file(WRITE "${BUILD_NUMBER_FILE}" "${BUILD_NUMBER}\n")

file(WRITE "${OUTPUT_HEADER}"
"#pragma once

// generated by cmake/BuildNumber.cmake at every build, do not edit

#define OSC_CAMERA_VERSION_MAJOR ${VERSION_MAJOR}
#define OSC_CAMERA_VERSION_MINOR ${VERSION_MINOR}
#define OSC_CAMERA_BUILD_NUMBER ${BUILD_NUMBER}
#define OSC_CAMERA_VERSION_STRING \"${VERSION_MAJOR}.${VERSION_MINOR}.${BUILD_NUMBER}\"
")

if(OUTPUT_INNO)
	file(WRITE "${OUTPUT_INNO}"
"; generated by cmake/BuildNumber.cmake at every build, do not edit

#define MyAppVersion \"${VERSION_MAJOR}.${VERSION_MINOR}.${BUILD_NUMBER}\"
#define MyAppVersionInfo \"${VERSION_MAJOR}.${VERSION_MINOR}.${BUILD_NUMBER}.0\"
")
endif()
